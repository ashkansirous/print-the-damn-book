    "15.jpg": {
      "text": "\u0627\u0648\u0646 \u0634\u0628\u060C \u06AF\u0648\u0634\u06CC \u06A9\u0627\u062A\u0631\u06CC\u0646 \u0632\u0646\u06AF \u062E\u0648\u0631\u062F. \u062F\u06CC\u0646\u06AF \u062F\u06CC\u0646\u06AF! \u062A\u0648 \u0635\u0641\u062D\u0647\u200C\u06CC \u06AF\u0648\u0634\u06CC \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u0628\u0648\u062F\u0646\u060C \u062A\u0648 \u062E\u0648\u0646\u0647\u200C\u0634\u0648\u0646 \u062A\u0648 \u062C\u0632\u06CC\u0631\u0647\u200C\u06CC \u0645\u0631\u063A\u0627\u06CC \u062F\u0631\u06CC\u0627\u06CC\u06CC\u060C \u0645\u0627\u062F\u0631\u062C\u0648\u0646 \u0648 \u0622\u0642\u0627\u062C\u0648\u0646 \u0647\u0645 \u0628\u0648\u062F\u0646!\n\n\u0022\u0645\u0627 \u0647\u0645\u0647 \u062F\u0644\u0645\u0648\u0646 \u0628\u0631\u0627\u062A \u062A\u0646\u06AF \u0634\u062F\u0647\u060C \u0648 \u062A\u0648 \u0631\u0648 \u0627\u0632 \u06A9\u0644 \u062F\u0646\u06CC\u0627 \u0628\u06CC\u0634\u062A\u0631 \u062F\u0648\u0633\u062A \u062F\u0627\u0631\u06CC\u0645!\u0022 \u0647\u0645\u0647 \u0628\u0627 \u0647\u0645 \u06AF\u0641\u062A\u0646.\n\n\u0022\u0645\u0646\u0645 \u0634\u0645\u0627 \u0631\u0648 \u0627\u0632 \u06A9\u0644 \u062F\u0646\u06CC\u0627 \u0628\u06CC\u0634\u062A\u0631 \u062F\u0648\u0633\u062A \u062F\u0627\u0631\u0645!\u0022 \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06AF\u0641\u062A. \u0628\u0631\u0627\u0634\u0648\u0646 \u0628\u0648\u0633 \u0641\u0631\u0633\u062A\u0627\u062F. \u0645\u0627\u0686! \u0645\u0627\u0686! \u0645\u0627\u0686!",
      "placement": "OnPicture",
      "band": "Bottom"
    },
    "16.jpg": {
      "text": "\u0627\u0648\u0646 \u0634\u0628\u060C \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0631\u0648 \u06A9\u0644\u0627\u0647 \u06AF\u0646\u062F\u0647\u200C\u06CC \u06A9\u0627\u062A\u0631\u06CC\u0646 \u062C\u0627 \u062E\u0648\u0634 \u06A9\u0631\u062F \u0648 \u0628\u0647 \u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627 \u0646\u06AF\u0627\u0647 \u06A9\u0631\u062F.\n\n\u0647\u0646\u0648\u0632\u0645 \u062F\u0644\u0634 \u0628\u0631\u0627\u06CC \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u062A\u0646\u06AF \u0628\u0648\u062F\u060C \u0628\u0631\u0627\u06CC \u0645\u0627\u062F\u0631\u062C\u0648\u0646 \u0648 \u0622\u0642\u0627\u062C\u0648\u0646 \u0647\u0645. \u0648\u0644\u06CC \u0645\u06CC\u200C\u062F\u0648\u0646\u0633\u062A \u06A9\u0647 \u062F\u0648\u0633\u0634 \u062F\u0627\u0631\u0646\u060C \u0686\u0647 \u0646\u0632\u062F\u06CC\u06A9 \u0628\u0627\u0634\u0646 \u0686\u0647 \u062F\u0648\u0631. \u0648 \u062F\u0644\u0634 \u0644\u06A9 \u0632\u062F\u0647 \u0628\u0648\u062F \u06A9\u0647 \u0632\u0648\u062F\u06CC \u062F\u0648\u0628\u0627\u0631\u0647 \u0647\u0645\u0647\u200C\u0634\u0648\u0646\u0648 \u0628\u0628\u06CC\u0646\u0647!\n\n\u0022\u0642\u0627\u0642 \u0642\u0627\u0642 \u0642\u0627\u0642\u060C\u0022 \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0622\u0631\u0648\u0645 \u06AF\u0641\u062A \u0648 \u0686\u0634\u0645\u0627\u0634\u0648 \u0628\u0633\u062A.",
