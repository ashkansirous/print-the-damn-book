    "13.jpg": {
      "text": "\u0635\u0628\u062D \u0641\u0631\u062F\u0627\u0634\u060C \u0647\u0648\u0627\u067E\u06CC\u0645\u0627\u06CC \u06A9\u0648\u0686\u0648\u0644\u0648 \u0631\u0648 \u0622\u0628 \u0645\u0646\u062A\u0638\u0631 \u0628\u0648\u062F. \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06CC\u0647 \u0628\u0648\u0633 \u062E\u062F\u0627\u062D\u0627\u0641\u0638\u06CC \u0628\u0647 \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u062F\u0627\u062F\u0646. \u0645\u0627\u0686! \u0645\u0627\u0686!\n\n\u0022\u062E\u062F\u0627\u062D\u0627\u0641\u0638 \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06A9\u0648\u0686\u0648\u0644\u0648! \u0628\u0647\u062A \u0632\u0646\u06AF \u0645\u06CC\u200C\u0632\u0646\u06CC\u0645\u060C \u062F\u0648\u0628\u0627\u0631\u0647 \u0647\u0645 \u0647\u0645\u062F\u06CC\u06AF\u0647 \u0631\u0648 \u0645\u06CC\u200C\u0628\u06CC\u0646\u06CC\u0645!\u0022 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06AF\u0641\u062A.\n\n\u0022\u062E\u062F\u0627\u062D\u0627\u0641\u0638 \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF! \u062E\u062F\u0627\u062D\u0627\u0641\u0638 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF! \u062F\u0648\u0633\u062A\u062A\u0648\u0646 \u062F\u0627\u0631\u0645!\u0022 \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06AF\u0641\u062A.\n\n\u0628\u0639\u062F \u067E\u0631\u06CC\u062F\u0646 \u062A\u0648 \u0647\u0648\u0627\u067E\u06CC\u0645\u0627.",
      "placement": "OnPicture",
      "band": "Bottom"
    },
    "14.jpg": {
      "text": "\u0648\u0648\u0648\u0648\u0648\u0645! \u0647\u0648\u0627\u067E\u06CC\u0645\u0627\u06CC \u06A9\u0648\u0686\u0648\u0644\u0648 \u0631\u0641\u062A \u0628\u0627\u0644\u0627 \u0648 \u0628\u0627\u0644\u0627 \u0648 \u0628\u0627\u0644\u0627\u060C \u0627\u0632 \u0631\u0648\u06CC \u062F\u0631\u06CC\u0627 \u0631\u062F \u0634\u062F \u0648 \u0631\u0641\u062A \u062A\u0627 \u062E\u0648\u0646\u0647\u200C\u0634\u0648\u0646 \u062A\u0648 \u062C\u0632\u06CC\u0631\u0647\u200C\u06CC \u0645\u0631\u063A\u0627\u06CC \u062F\u0631\u06CC\u0627\u06CC\u06CC.\n\n\u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0648 \u06A9\u0627\u062A\u0631\u06CC\u0646 \u0648 \u067E\u0648\u0644\u06CC \u067E\u0646\u06A9\u06CC\u06A9\u06CC \u0647\u06CC \u062F\u0633\u062A \u062A\u06A9\u0648\u0646 \u062F\u0627\u062F\u0646 \u0648 \u062F\u0633\u062A \u062A\u06A9\u0648\u0646 \u062F\u0627\u062F\u0646\u060C \u062A\u0627 \u0647\u0648\u0627\u067E\u06CC\u0645\u0627 \u0634\u062F \u06CC\u0647 \u0646\u0642\u0637\u0647\u200C\u06CC \u06A9\u0648\u0686\u0648\u0644\u0648 \u062A\u0648 \u0622\u0633\u0645\u0648\u0646.",
