    },
    "11.jpg": {
      "text": "\u0631\u0648\u0632\u0627 \u06AF\u0630\u0634\u062A\u0646\u060C \u067E\u0631 \u0627\u0632 \u0628\u0627\u0632\u06CC \u0648 \u0628\u063A\u0644. \u06CC\u0647 \u0634\u0628\u060C \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06AF\u0641\u062A \u0648\u0642\u062A\u0634\u0647 \u067E\u0631\u0648\u0627\u0632 \u06A9\u0646\u0646 \u0628\u0631\u06AF\u0631\u062F\u0646 \u062E\u0648\u0646\u0647. \u062E\u0648\u0646\u0647\u200C\u06CC \u06AF\u0631\u0645 \u0648 \u0646\u0631\u0645\u0634\u0648\u0646 \u062A\u0648 \u062C\u0632\u06CC\u0631\u0647\u200C\u06CC \u0645\u0631\u063A\u0627\u06CC \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0645\u0646\u062A\u0638\u0631\u0634\u0648\u0646 \u0628\u0648\u062F.\n\n\u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0633\u0631\u0634\u0648 \u0627\u0646\u062F\u0627\u062E\u062A \u067E\u0627\u06CC\u06CC\u0646. \u062F\u0644\u0634 \u062E\u06CC\u0644\u06CC \u0628\u0631\u0627\u06CC \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u062A\u0646\u06AF \u0645\u06CC\u200C\u0634\u062F\u060C \u0628\u0631\u0627\u06CC \u0645\u0627\u062F\u0631\u062C\u0648\u0646 \u0648 \u0622\u0642\u0627\u062C\u0648\u0646 \u0647\u0645\u060C \u0627\u0648\u0646 \u06CC\u06A9\u06CC \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF\u0634 \u06A9\u0647 \u062F\u0648\u0631 \u0628\u0648\u062F\u0646.\n\n\u0022\u0645\u0627 \u0647\u0645 \u062F\u0644\u0645\u0648\u0646 \u0628\u0631\u0627\u062A \u062A\u0646\u06AF \u0645\u06CC\u200C\u0634\u0647 \u0639\u0632\u06CC\u0632\u0645\u060C\u0022 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06AF\u0641\u062A.",
      "placement": "OnPicture",
      "band": "Bottom"
    },
    "12.jpg": {
      "text": "\u06A9\u0627\u062A\u0631\u06CC\u0646 \u0648 \u067E\u0648\u0644\u06CC \u067E\u0646\u06A9\u06CC\u06A9\u06CC \u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0631\u0648 \u0622\u0631\u0648\u0645 \u0628\u063A\u0644 \u06A9\u0631\u062F\u0646.\n\n\u0022\u0648\u0642\u062A\u06CC \u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF \u0628\u0631\u06AF\u0631\u062F\u0646 \u062E\u0648\u0646\u0647\u060C \u0628\u0627\u0632\u0645 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC \u062A\u0648 \u06AF\u0648\u0634\u06CC\u0645 \u0628\u0628\u06CC\u0646\u06CC\u0634\u0648\u0646\u060C\u0022 \u06A9\u0627\u062A\u0631\u06CC\u0646 \u06AF\u0641\u062A. \u0022\u0645\u0627\u0645\u0627\u0646\u200C\u0628\u0632\u0631\u06AF\u0627 \u0648 \u0628\u0627\u0628\u0627\u0628\u0632\u0631\u06AF\u0627 \u0646\u0648\u0647\u200C\u0647\u0627\u0634\u0648\u0646\u0648 \u062E\u06CC\u0644\u06CC \u062E\u06CC\u0644\u06CC \u062F\u0648\u0633\u062A \u062F\u0627\u0631\u0646. \u0647\u0631 \u0648\u0642\u062A \u0628\u062A\u0648\u0646\u0646 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646 \u0628\u0628\u06CC\u0646\u0646\u0634\u0648\u0646\u060C \u06CC\u0627 \u0645\u06CC\u0627\u0646 \u067E\u06CC\u0634\u0634\u0648\u0646 \u06CC\u0627 \u062A\u0635\u0648\u06CC\u0631\u06CC \u0632\u0646\u06AF \u0645\u06CC\u200C\u0632\u0646\u0646! \u062F\u0648\u0628\u0627\u0631\u0647 \u0647\u0645 \u0645\u06CC\u200C\u0628\u06CC\u0646\u06CC\u0634\u0648\u0646!\u0022\n\n\u0645\u0631\u063A \u062F\u0631\u06CC\u0627\u06CC\u06CC \u062A\u0648 \u0628\u063A\u0644\u0634\u0648\u0646 \u062C\u0627 \u062E\u0648\u0634 \u06A9\u0631\u062F \u0648 \u062D\u0627\u0644\u0634 \u062E\u06CC\u0644\u06CC \u0628\u0647\u062A\u0631 \u0634\u062F.",
      "placement": "OnPicture",
      "band": "Bottom"
