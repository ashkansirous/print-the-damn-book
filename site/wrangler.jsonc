{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "print-the-damn-book-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "print-the-damn-book.sirous.uk", "custom_domain": true }
  ]
}
