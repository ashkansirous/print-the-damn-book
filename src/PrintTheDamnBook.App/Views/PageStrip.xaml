<UserControl x:Class="PrintTheDamnBook.App.Views.PageStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels">
  <GroupBox>
    <GroupBox.Header>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Pages in order" VerticalAlignment="Center" />
        <Button Content="Add pages..." Margin="12,0,0,0" Padding="10,2" Click="OnAddPagesClick"
                IsEnabled="{Binding CanAddPages}" />
        <TextBlock Text="Drag a page to move it; the covers stay at the ends." Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </GroupBox.Header>
    <ScrollViewer x:Name="StripScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Pages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <Border x:Name="DragSurface" Margin="2" Padding="2" Background="Transparent" AllowDrop="True"
                    PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseLeftButtonUp="OnItemMouseUp"
                    MouseMove="OnItemMouseMove" MouseLeave="OnItemMouseLeave"
                    DragOver="OnItemDragOver" DragLeave="OnItemDragLeave" Drop="OnItemDrop">
              <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageTemplate}" />
                <Button Content="Remove" Padding="8,1" Margin="0,2,0,0" HorizontalAlignment="Center"
                        Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Source}"
                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </GroupBox>
</UserControl>
