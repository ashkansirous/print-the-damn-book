<Window x:Class="PrintTheDamnBook.App.Views.DinoStoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:PrintTheDamnBook.App.Views"
        Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Title="Stories from Dino" AutomationProperties.Name="Stories from Dino">
  <!-- Slice 18: the "Stories from Dino" dialog (StoryCheck.dc.html:274-337). DataContext is a DinoStoreViewModel. -->
  <Window.Resources>
    <!-- Phosphor 2.1.1 code points. -->
    <sys:String x:Key="IconStorefront">&#xE470;</sys:String>
    <sys:String x:Key="IconTranslateGlyph">&#xE4A2;</sys:String>
    <sys:String x:Key="IconWifiSlash">&#xE4F2;</sys:String>
    <sys:String x:Key="IconShieldCheck">&#xE40C;</sys:String>
    <sys:String x:Key="IconInfo">&#xE2CE;</sys:String>
    <sys:String x:Key="IconImage">&#xE2CA;</sys:String>
    <sys:String x:Key="IconArrowClockwise">&#xE036;</sys:String>
    <views:AspectHeightConverter x:Key="ThreeByFour" Ratio="1.3333333" />

    <!-- One book: cover, title, language and size; a button, so the keyboard and Narrator get it too. -->
    <Style x:Key="StoreCardButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Text6Brush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A 4 px bar: neutral-800 track, accent fill with a soft glow. -->
    <Style x:Key="DownloadBar" TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Height" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{StaticResource Neutral800Brush}" CornerRadius="2" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="2" Effect="{StaticResource StepGlow}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ph image 22 px until the cover arrives. -->
    <Style x:Key="CoverPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource Ph}">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DownloadTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MaxWidth" Value="260" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Downloading.IsRightToLeft}" Value="True">
          <Setter Property="FlowDirection" Value="RightToLeft" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BookTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsRightToLeft}" Value="True">
          <Setter Property="FlowDirection" Value="RightToLeft" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
  </Window.InputBindings>

  <Grid Background="{StaticResource BackdropBrush}">
    <Border MaxWidth="880" Margin="40" Padding="11.2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource Neutral500Brush}" BorderThickness="1" CornerRadius="14" Effect="{StaticResource ShadowLg}">
      <StackPanel>
        <!-- Title, sub-line, language select, Close -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Stories from Dino" FontSize="20" FontWeight="Medium" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Free books from Dino Reader's store. Pick one and I'll open it here, words and all." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                      Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Ph}" Text="{StaticResource IconTranslateGlyph}" Foreground="{StaticResource Neutral400Brush}" Margin="0,0,8,0" />
            <ComboBox MinWidth="190" ItemsSource="{Binding Languages}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                      AutomationProperties.Name="Language">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource GhostButton}" views:Ui.Icon="{StaticResource IconX}" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                  Margin="12,0,0,0" ToolTip="Close" AutomationProperties.Name="Close" />
        </Grid>

        <!-- Loading the list -->
        <Grid MinHeight="420" Margin="8,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Spinner}" FontSize="32" Text="{StaticResource IconCircleNotch}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
            <TextBlock Text="Loading stories…" FontSize="15" FontWeight="Medium" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource Muted}" Text="Asking dinoreader.sirous.uk for its list." Margin="0,10,0,0" />
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    AutomationProperties.Name="Cancel loading stories" />
          </StackPanel>
        </Grid>

        <!-- Offline or failed -->
        <Grid MinHeight="420" Margin="8,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Ph}" FontSize="32" Text="{StaticResource IconWifiSlash}" Foreground="{StaticResource Neutral400Brush}" HorizontalAlignment="Left" />
            <TextBlock Text="I couldn't reach Dino's store" FontSize="15" FontWeight="Medium" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource Muted}" MaxWidth="380" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding FailureReason}" AutomationProperties.Name="Why it failed"
                       Visibility="{Binding FailureReason, Converter={StaticResource PresentToVisibility}}" />
            <TextBlock Style="{StaticResource Muted}" MaxWidth="380" Margin="0,10,0,0"
                       Text="Check the internet connection and try again. Folders and .dino files on this PC still open as usual." />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="Try again" views:Ui.Icon="{StaticResource IconArrowClockwise}" Command="{Binding RetryCommand}"
                      AutomationProperties.Name="Try again" />
              <Button Style="{StaticResource GhostButton}" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" AutomationProperties.Name="Close the store" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- The store answered but has nothing to open -->
        <Grid MinHeight="420" Margin="8,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Ph}" FontSize="32" Text="{StaticResource IconStorefront}" Foreground="{StaticResource Neutral400Brush}" HorizontalAlignment="Left" />
            <TextBlock Text="Dino's store has no stories I can open right now." FontSize="15" FontWeight="Medium" Margin="0,10,0,0" AutomationProperties.Name="No stories" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="Try again" views:Ui.Icon="{StaticResource IconArrowClockwise}" Command="{Binding RetryCommand}"
                      AutomationProperties.Name="Try again" />
              <Button Style="{StaticResource GhostButton}" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" AutomationProperties.Name="Close the store" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- The list -->
        <StackPanel Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}" Margin="0,8.4,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8.4" Visibility="{Binding Note, Converter={StaticResource PresentToVisibility}}">
            <TextBlock Style="{StaticResource Ph}" FontSize="14" Text="{StaticResource IconInfo}" Foreground="{StaticResource Accent300Brush}" Margin="0,0,6,0" />
            <TextBlock FontSize="12" Foreground="{StaticResource Neutral400Brush}" Text="{Binding Note}" AutomationProperties.Name="Download note" />
          </StackPanel>
          <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" Padding="2">
            <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="Stories">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource StoreCardButton}" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Title}"
                          Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ThreeByFour}}" Background="{StaticResource Neutral800Brush}"
                              CornerRadius="2" ClipToBounds="True" Effect="{StaticResource ShadowMd}">
                        <Grid>
                          <TextBlock Style="{StaticResource CoverPlaceholder}" Text="{StaticResource IconImage}" />
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Grid>
                      </Border>
                      <TextBlock Style="{StaticResource BookTitle}" Text="{Binding Title}" Margin="0,5,0,0" />
                      <TextBlock FontSize="11" Foreground="{StaticResource Neutral500Brush}" Text="{Binding LanguageAndMeta}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                      <TextBlock FontSize="11" Foreground="{StaticResource Neutral400Brush}" Text="This language is not supported yet" TextWrapping="Wrap" Margin="0,5,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Downloading -->
        <Grid MinHeight="420" Margin="8,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="132" Height="176" Background="{StaticResource Neutral800Brush}" CornerRadius="2" ClipToBounds="True" Effect="{StaticResource ShadowMd}" VerticalAlignment="Center">
              <Image Source="{Binding Downloading.Cover}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Width="400" Margin="24,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="15" FontWeight="Medium" Text="Downloading " />
                <TextBlock Style="{StaticResource DownloadTitle}" Text="{Binding DownloadTitle}" />
                <TextBlock FontSize="15" FontWeight="Medium" Text="…" />
              </StackPanel>
              <ProgressBar Style="{StaticResource DownloadBar}" Value="{Binding DownloadPercent}" Margin="0,10,0,0" AutomationProperties.Name="Download" />
              <TextBlock FontSize="12" Foreground="{StaticResource Neutral400Brush}" Text="{Binding DownloadText}" Margin="0,10,0,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                      AutomationProperties.Name="Cancel download" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- What is sent, always shown -->
        <StackPanel Orientation="Horizontal" Margin="0,8.4,0,0">
          <TextBlock Style="{StaticResource Ph}" FontSize="13" Text="{StaticResource IconShieldCheck}" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,6,0" />
          <TextBlock FontSize="11" Foreground="{StaticResource Neutral500Brush}" VerticalAlignment="Center"
                     Text="I fetch only the list, the covers and the book you pick. No identifiers, cookies or analytics are sent; like any web request, the store sees this PC's internet address." TextWrapping="Wrap" MaxWidth="780" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
