<UserControl x:Class="PrintTheDamnBook.App.Views.DoneStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels"
             xmlns:views="clr-namespace:PrintTheDamnBook.App.Views">
  <!-- DataContext is the MainViewModel. -->
  <StackPanel HorizontalAlignment="Left" MaxWidth="780">
    <ItemsControl ItemsSource="{Binding FoldSteps}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:FoldStepViewModel}">
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="{Binding Number}" FontSize="28" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding Title}" FontWeight="Medium" Margin="0,8,0,0" />
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Body}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
      <Button Style="{StaticResource SecondaryButton}" Content="Print another copy" views:Ui.Icon="{StaticResource IconPrinter}"
              Command="{Binding PrintAnotherCommand}" Margin="0,0,8,0" AutomationProperties.Name="Print another copy" />
      <Button Style="{StaticResource GhostButton}" Content="Make another book" views:Ui.Icon="{StaticResource IconFolderOpen}"
              Command="{Binding MakeAnotherCommand}" AutomationProperties.Name="Make another book" />
    </StackPanel>
  </StackPanel>
</UserControl>
