<UserControl x:Class="PrintTheDamnBook.App.Views.OptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DataContext is the PrintViewModel. -->
  <WrapPanel>
    <TextBlock Text="Printer:" VerticalAlignment="Center" Margin="0,0,6,4" />
    <ComboBox Width="260" Margin="0,0,0,4" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name" />
    <TextBlock Text="Paper:" VerticalAlignment="Center" Margin="12,0,6,4" />
    <ComboBox Width="80" Margin="0,0,0,4" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}" />
    <TextBlock Text="Scaling:" VerticalAlignment="Center" Margin="12,0,6,4" />
    <ComboBox Width="130" Margin="0,0,0,4" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding ScalingChoices}" DisplayMemberPath="Label"
              SelectedValuePath="Value" SelectedValue="{Binding Scaling}" />
    <TextBlock Text="Margin (mm):" VerticalAlignment="Center" Margin="12,0,6,4" />
    <TextBox Width="40" Margin="0,0,0,4" VerticalContentAlignment="Center" IsEnabled="{Binding IsIdle}"
             Text="{Binding MarginText, UpdateSourceTrigger=LostFocus}" />
    <TextBlock Text="Two-sided:" VerticalAlignment="Center" Margin="12,0,6,4" />
    <ComboBox Width="220" Margin="0,0,0,4" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding DuplexChoices}" SelectedItem="{Binding SelectedDuplex}" DisplayMemberPath="Label" />
    <StackPanel Orientation="Horizontal" Margin="12,0,0,4" Visibility="{Binding IsAutomatic, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Flip edge:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox Width="210" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding FlipChoices}" DisplayMemberPath="Label"
                SelectedValuePath="Value" SelectedValue="{Binding Flip}" />
    </StackPanel>
    <CheckBox Content="Reverse order of backs" VerticalAlignment="Center" Margin="12,0,0,4" IsChecked="{Binding ReverseBacks}" IsEnabled="{Binding IsIdle}"
              Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
    <CheckBox Content="Rotate backs 180°" VerticalAlignment="Center" Margin="12,0,0,4" IsChecked="{Binding RotateBacks}" IsEnabled="{Binding IsIdle}"
              Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
    <CheckBox Content="Print cover sheet as a separate job" VerticalAlignment="Center" Margin="12,0,0,4" IsChecked="{Binding SeparateCoverJob}" IsEnabled="{Binding IsIdle}" />
  </WrapPanel>
</UserControl>
