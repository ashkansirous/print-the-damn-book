<UserControl x:Class="PrintTheDamnBook.App.Views.PrintStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels"
             xmlns:layout="clr-namespace:PrintTheDamnBook.Core.Layout;assembly=PrintTheDamnBook.Core"
             xmlns:text="clr-namespace:PrintTheDamnBook.Core.Text;assembly=PrintTheDamnBook.Core"
             xmlns:views="clr-namespace:PrintTheDamnBook.App.Views">
  <!-- DataContext is the MainViewModel; the printer options live on its Print view model. -->
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text70Brush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="OptionsToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <TextBlock x:Name="Caret" Style="{StaticResource Ph}" FontSize="14" Text="{StaticResource IconCaretRight}" Foreground="{StaticResource Neutral400Brush}" />
              <TextBlock Text="More options" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Neutral300Brush}" FontWeight="Medium" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Caret" Property="Text" Value="{StaticResource IconCaretDown}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Caret" Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <WrapPanel Orientation="Horizontal">
    <!-- Left column; the right column wraps below it when the window is narrow. -->
    <StackPanel MinWidth="260" MaxWidth="420" Margin="0,0,40,24" DataContext="{Binding Print}">
      <TextBlock Style="{StaticResource FieldLabel}" Text="Printer" />
      <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Printer">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding DuplexNote}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding DuplexNote, Converter={StaticResource PresentToVisibility}}" />

      <TextBlock Style="{StaticResource FieldLabel}" Text="Paper" Margin="0,18,0,5" />
      <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource SegOption}" Content="A4" GroupName="Paper" AutomationProperties.Name="A4"
                       IsChecked="{Binding SelectedPaper, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:PaperKind.A4}}" />
          <Rectangle Style="{StaticResource SegDivider}" />
          <RadioButton Style="{StaticResource SegOption}" Content="Letter" GroupName="Paper" AutomationProperties.Name="Letter"
                       IsChecked="{Binding SelectedPaper, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:PaperKind.Letter}}" />
        </StackPanel>
      </Border>

      <ToggleButton Style="{StaticResource SwitchRow}" Margin="0,18,0,0" IsChecked="{Binding SeparateCoverJob}" IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="Print the cover sheet on its own">
        <StackPanel>
          <TextBlock Text="Print the cover sheet on its own" />
          <TextBlock Text="I'll pause after it so you can load thicker paper for the rest." FontSize="12" Foreground="{StaticResource Neutral500Brush}"
                     TextWrapping="Wrap" MaxWidth="340" Margin="0,2,0,0" />
        </StackPanel>
      </ToggleButton>

      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,18,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Ph}" Text="{StaticResource IconArrowsCounterClockwise}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="First time with this printer?" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                     Text="{Binding DataContext.TestSheetText, RelativeSource={RelativeSource AncestorType=views:PrintStepView}}" />
          <Button Style="{StaticResource SecondaryButton}" Content="Print test sheet" views:Ui.Icon="{StaticResource IconPrinter}"
                  Command="{Binding PrintTestSheetCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Print test sheet" />
        </StackPanel>
      </Border>

      <Button Style="{StaticResource SecondaryButton}" Content="Print backs again" views:Ui.Icon="{StaticResource IconArrowsClockwise}"
              Command="{Binding PrintBacksAgainCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Print backs again"
              Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />

      <ToggleButton x:Name="MoreOptions" Style="{StaticResource OptionsToggle}" Margin="0,22,0,0" HorizontalAlignment="Left"
                    IsChecked="{Binding DataContext.IsMoreOptionsOpen, RelativeSource={RelativeSource AncestorType=views:PrintStepView}, Mode=TwoWay}"
                    AutomationProperties.Name="More options" />
      <StackPanel Margin="0,14,0,0" Visibility="{Binding IsChecked, ElementName=MoreOptions, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="Pages on the sheet" />
        <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegOption}" Content="Fit (whole page)" GroupName="Scaling" AutomationProperties.Name="Fit whole page"
                         IsChecked="{Binding Scaling, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:ScalingMode.Fit}}" />
            <Rectangle Style="{StaticResource SegDivider}" />
            <RadioButton Style="{StaticResource SegOption}" Content="Fill and crop" GroupName="Scaling" AutomationProperties.Name="Fill and crop"
                         IsChecked="{Binding Scaling, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:ScalingMode.Fill}}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Margin (mm)" Margin="0,14,0,5" />
        <TextBox Width="80" HorizontalAlignment="Left" IsEnabled="{Binding IsIdle}" Text="{Binding MarginText, UpdateSourceTrigger=LostFocus}"
                 AutomationProperties.Name="Margin in millimetres" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Page numbers" Margin="0,14,0,5" />
        <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegOption}" Content="Off" GroupName="PageNumbers" AutomationProperties.Name="Page numbers off"
                         IsChecked="{Binding PageNumbers, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:PageNumberPosition.Off}}" />
            <Rectangle Style="{StaticResource SegDivider}" />
            <RadioButton Style="{StaticResource SegOption}" Content="Below" GroupName="PageNumbers" AutomationProperties.Name="Page numbers below"
                         IsChecked="{Binding PageNumbers, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:PageNumberPosition.Below}}" />
            <Rectangle Style="{StaticResource SegDivider}" />
            <RadioButton Style="{StaticResource SegOption}" Content="Above" GroupName="PageNumbers" AutomationProperties.Name="Page numbers above"
                         IsChecked="{Binding PageNumbers, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:PageNumberPosition.Above}}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Text pages" Margin="0,14,0,5" />
        <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegOption}" Content="White" GroupName="TextPages" AutomationProperties.Name="Text pages white"
                         IsChecked="{Binding TextPages, Converter={StaticResource EnumBool}, ConverterParameter={x:Static text:TextPageBackground.White}}" />
            <Rectangle Style="{StaticResource SegDivider}" />
            <RadioButton Style="{StaticResource SegOption}" Content="Tinted from cover" GroupName="TextPages" AutomationProperties.Name="Text pages tinted from the cover"
                         IsChecked="{Binding TextPages, Converter={StaticResource EnumBool}, ConverterParameter={x:Static text:TextPageBackground.TintedFromCover}}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Two-sided" Margin="0,14,0,5" />
        <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegOption}" Content="Automatic (printer)" GroupName="Duplex" AutomationProperties.Name="Automatic two-sided"
                         IsChecked="{Binding DuplexMode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:DuplexMode.Automatic}}" />
            <Rectangle Style="{StaticResource SegDivider}" />
            <RadioButton Style="{StaticResource SegOption}" Content="Manual (flip the stack yourself)" GroupName="Duplex" AutomationProperties.Name="Manual two-sided"
                         IsChecked="{Binding DuplexMode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:DuplexMode.Manual}}" />
          </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding IsAutomatic, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Flip edge" Margin="0,14,0,5" />
          <Border Style="{StaticResource SegBorder}" IsEnabled="{Binding IsIdle}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource SegOption}" Content="Short edge" GroupName="Flip" AutomationProperties.Name="Short edge"
                           IsChecked="{Binding Flip, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:FlipEdge.ShortEdge}}" />
              <Rectangle Style="{StaticResource SegDivider}" />
              <RadioButton Style="{StaticResource SegOption}" Content="Long edge (backs turned 180°)" GroupName="Flip" AutomationProperties.Name="Long edge"
                           IsChecked="{Binding Flip, Converter={StaticResource EnumBool}, ConverterParameter={x:Static layout:FlipEdge.LongEdge}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}">
          <ToggleButton Style="{StaticResource SwitchRow}" Margin="0,14,0,0" IsChecked="{Binding ReverseBacks}" IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="Reverse order of backs">
            <TextBlock Text="Reverse order of backs" />
          </ToggleButton>
          <ToggleButton Style="{StaticResource SwitchRow}" Margin="0,12,0,0" IsChecked="{Binding RotateBacks}" IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="Rotate backs 180 degrees">
            <TextBlock Text="Rotate backs 180°" />
          </ToggleButton>
        </StackPanel>

        <TextBlock Text="{Binding SettingsStatus}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding SettingsStatus, Converter={StaticResource PresentToVisibility}}" />
      </StackPanel>
    </StackPanel>

    <!-- Right column: the stack preview -->
    <StackPanel Width="320">
      <Grid Width="300" Height="220" HorizontalAlignment="Left">
        <ItemsControl ItemsSource="{Binding StackLayers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}" />
              <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:StackLayerViewModel}">
              <Border Width="264" Height="187" Background="{StaticResource Neutral200Brush}" BorderBrush="{StaticResource Neutral800Brush}" BorderThickness="1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Width="264" Height="187" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Neutral100Brush}"
                BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1" Effect="{StaticResource ShadowMd}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding StackLeft}" Stretch="Uniform" />
            <Rectangle Grid.Column="1">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="Transparent" Offset="0" />
                  <GradientStop Color="#B2B6CA" Offset="0.5" />
                  <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Image Grid.Column="2" Source="{Binding StackRight}" Stretch="Uniform" />
          </Grid>
        </Border>
      </Grid>
      <TextBlock Text="{Binding StackTitle}" FontWeight="Medium" Margin="0,16,0,0" />
      <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                 Text="Two pages per side, printed both sides. The line down the middle is where you fold." />
    </StackPanel>
  </WrapPanel>
</UserControl>
