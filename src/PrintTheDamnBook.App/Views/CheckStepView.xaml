<UserControl x:Class="PrintTheDamnBook.App.Views.CheckStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels"
             xmlns:views="clr-namespace:PrintTheDamnBook.App.Views">
  <!-- DataContext is the MainViewModel. -->
  <UserControl.Resources>
    <!-- An empty slot (the front cover has no left page, the back cover no right one) keeps its width but shows nothing. -->
    <Style x:Key="SlotStyle" TargetType="ContentControl">
      <Style.Triggers>
        <Trigger Property="Content" Value="{x:Null}">
          <Setter Property="Visibility" Value="Hidden" />
          <Setter Property="MaxHeight" Value="0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RemoveButton" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Opacity="0.75" x:Name="Root">
              <Ellipse x:Name="Disc" Fill="{StaticResource Bg70Brush}" />
              <TextBlock x:Name="Glyph" Style="{StaticResource Ph}" FontSize="12" Text="{StaticResource IconX}" HorizontalAlignment="Center"
                         Foreground="{StaticResource Neutral200Brush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="1" />
                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource BgBrush}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent300Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page in the reading-order view: draggable, removable, with its note under it. -->
    <DataTemplate x:Key="BookTile" DataType="{x:Type vm:PageViewModel}">
      <Border x:Name="DragSurface" Width="128" Background="Transparent" AllowDrop="True" ToolTip="{Binding ToolTip}" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
              AutomationProperties.Name="{Binding AutomationName}" PreviewKeyDown="OnTileKeyDown"
              PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseLeftButtonUp="OnTileMouseUp" MouseMove="OnTileMouseMove"
              MouseLeave="OnTileMouseLeave" DragOver="OnTileDragOver" DragLeave="OnTileDragLeave" Drop="OnTileDrop">
        <StackPanel>
          <Grid Width="128" Height="181">
            <Border x:Name="Ring" Background="{StaticResource Neutral100Brush}" BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1"
                    CornerRadius="2" Effect="{StaticResource ShadowMd}">
              <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
            <Rectangle x:Name="Dashes" Visibility="Collapsed" RadiusX="2" RadiusY="2" Stroke="{StaticResource Neutral700Brush}" StrokeThickness="1"
                       StrokeDashArray="4 3" />
            <TextBlock x:Name="BlankText" Visibility="Collapsed" Text="BLANK" FontSize="11" Foreground="{StaticResource Neutral600Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource WarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="6" Visibility="{Binding ShowsWarnBadge, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource PhFill}" FontSize="13" Text="{StaticResource IconWarning}" Foreground="{StaticResource BgBrush}"
                         HorizontalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource RemoveButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Remove from the book"
                    Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=views:CheckStepView}}"
                    CommandParameter="{Binding Source}" AutomationProperties.Name="{Binding Label, StringFormat=Remove {0} from the book}"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Height="16">
            <TextBlock Style="{StaticResource PhFill}" FontSize="11" Text="{StaticResource IconPushPin}" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Foreground="{StaticResource Neutral500Brush}"
                       Margin="0,0,5,0" ToolTip="Stays at the end" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Neutral300Brush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="110" />
          </StackPanel>
          <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Neutral500Brush}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowsWarnBadge}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Ring" Property="Effect" Value="{x:Null}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Note" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="Transparent" />
          <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="Ring" Property="Effect" Value="{x:Null}" />
          <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
          <Setter TargetName="BlankText" Property="Visibility" Value="Visible" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Neutral500Brush}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsBlank}" Value="True" />
            <Condition Binding="{Binding IsWarned}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="BlankText" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Note" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </MultiDataTrigger>
        <Trigger SourceName="DragSurface" Property="views:Ui.IsDragSource" Value="True">
          <Setter TargetName="DragSurface" Property="Opacity" Value="0.35" />
        </Trigger>
        <Trigger SourceName="DragSurface" Property="views:Ui.IsDropTarget" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Ring" Property="Effect" Value="{StaticResource DropGlow}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A page on a printed face (As printed view). -->
    <DataTemplate x:Key="SheetTile" DataType="{x:Type vm:PageViewModel}">
      <StackPanel Width="84" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AutomationName}">
        <Grid Width="84" Height="119">
          <Border x:Name="Ring" Background="{StaticResource Neutral100Brush}" BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1">
            <Image Source="{Binding Image}" Stretch="Uniform" />
          </Border>
          <Rectangle x:Name="Dashes" Visibility="Collapsed" Stroke="{StaticResource Neutral700Brush}" StrokeThickness="1" StrokeDashArray="4 3" />
          <TextBlock x:Name="BlankText" Visibility="Collapsed" Text="BLANK" FontSize="10" Foreground="{StaticResource Neutral600Brush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource WarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="4" Visibility="{Binding ShowsWarnBadge, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource PhFill}" FontSize="11" Text="{StaticResource IconWarning}" Foreground="{StaticResource BgBrush}"
                       HorizontalAlignment="Center" />
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,0" CornerRadius="3" Background="{StaticResource Neutral900Brush}"
                  ToolTip="Printed page number">
            <Border.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                <Binding Path="HasPrintedNumber" />
                <Binding Path="DataContext.ShowsPageNumbers" RelativeSource="{RelativeSource AncestorType=views:CheckStepView}" />
              </MultiBinding>
            </Border.Visibility>
            <TextBlock Text="{Binding PrintedNumber}" FontSize="10" Foreground="{StaticResource Neutral200Brush}" />
          </Border>
        </Grid>
        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Neutral300Brush}" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowsWarnBadge}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="Transparent" />
          <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
          <Setter TargetName="BlankText" Property="Visibility" Value="Visible" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Neutral500Brush}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsBlank}" Value="True" />
            <Condition Binding="{Binding IsWarned}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="BlankText" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FaceTemplate" DataType="{x:Type vm:FaceViewModel}">
      <StackPanel Orientation="Horizontal">
        <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource SheetTile}" Margin="0,0,1,0" />
        <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource SheetTile}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <!-- Warning chips -->
    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,-4,0,18" Visibility="{Binding HasChips, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource WarningTintBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8" AutomationProperties.Name="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource PhFill}" FontSize="12" Text="{StaticResource IconWarning}" Foreground="{StaticResource WarningBrush}" />
              <TextBlock Text="{Binding}" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Reading order: spreads -->
    <ItemsControl ItemsSource="{Binding Spreads}" Visibility="{Binding IsReadingView, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:SpreadViewModel}">
          <StackPanel Margin="0,0,30,28">
            <StackPanel Orientation="Horizontal">
              <ContentControl Width="128" VerticalAlignment="Top" Margin="0,0,2,0" Content="{Binding Left}" ContentTemplate="{StaticResource BookTile}" Style="{StaticResource SlotStyle}" />
              <ContentControl Width="128" VerticalAlignment="Top" Content="{Binding Right}" ContentTemplate="{StaticResource BookTile}" Style="{StaticResource SlotStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource Neutral600Brush}" Margin="0,8,0,0" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- As printed: sheets -->
    <ItemsControl ItemsSource="{Binding Sheets}" Visibility="{Binding IsSheetsView, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:SheetViewModel}">
          <Border Style="{StaticResource Card}" Padding="16,14,16,16" Margin="0,0,16,16" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                <Border Style="{StaticResource TagAccent}" Margin="8,0,0,0" Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock FontSize="11" Text="test sheet + covers" Foreground="{StaticResource Accent100Brush}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="FRONT" FontSize="10" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,0,6" />
                  <ContentControl Content="{Binding Front}" ContentTemplate="{StaticResource FaceTemplate}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="BACK" FontSize="10" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,0,6" />
                  <ContentControl Content="{Binding Back}" ContentTemplate="{StaticResource FaceTemplate}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
