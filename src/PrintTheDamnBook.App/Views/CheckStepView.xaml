<UserControl x:Class="PrintTheDamnBook.App.Views.CheckStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels"
             xmlns:text="clr-namespace:PrintTheDamnBook.Core.Text;assembly=PrintTheDamnBook.Core"
             xmlns:views="clr-namespace:PrintTheDamnBook.App.Views">
  <!-- DataContext is the MainViewModel. -->
  <UserControl.Resources>
    <!-- Phosphor 2.1.1 code points for the story text editor (regular and fill share them). -->
    <sys:String x:Key="IconTextAa">&#xE6EE;</sys:String>
    <sys:String x:Key="IconArrowsIn">&#xE09A;</sys:String>
    <sys:String x:Key="IconImageSquare">&#xE2CC;</sys:String>
    <sys:String x:Key="IconBookOpenTextPlacement">&#xE8F2;</sys:String>
    <sys:String x:Key="IconInfo">&#xE2CE;</sys:String>
    <sys:String x:Key="IconEraser">&#xE21E;</sys:String>
    <sys:String x:Key="IconCheckCircle">&#xE184;</sys:String>
    <sys:String x:Key="IconCaretLeft">&#xE138;</sys:String>
    <sys:String x:Key="IconCaretRight2">&#xE13A;</sys:String>
    <sys:String x:Key="IconCheckSmall">&#xE182;</sys:String>
    <FontFamily x:Key="AndikaFont">pack://application:,,,/Fonts/#Andika</FontFamily>

    <!-- The small field label of the editor (as on the Print step). -->
    <Style x:Key="EditorLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Text70Brush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="EditorNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Neutral400Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- An empty slot (the front cover has no left page, the back cover no right one) keeps its width but shows nothing. -->
    <Style x:Key="SlotStyle" TargetType="ContentControl">
      <Style.Triggers>
        <Trigger Property="Content" Value="{x:Null}">
          <Setter Property="Visibility" Value="Hidden" />
          <Setter Property="MaxHeight" Value="0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RemoveButton" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Opacity="0.75" x:Name="Root">
              <Ellipse x:Name="Disc" Fill="{StaticResource Bg70Brush}" />
              <TextBlock x:Name="Glyph" Style="{StaticResource Ph}" FontSize="12" Text="{StaticResource IconX}" HorizontalAlignment="Center"
                         Foreground="{StaticResource Neutral200Brush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="1" />
                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource BgBrush}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent300Brush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page in the reading-order view: draggable, removable, with its note under it. -->
    <DataTemplate x:Key="BookTile" DataType="{x:Type vm:PageViewModel}">
      <Border x:Name="DragSurface" Width="128" Background="Transparent" AllowDrop="True" ToolTip="{Binding ToolTip}" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
              AutomationProperties.Name="{Binding AutomationName}" PreviewKeyDown="OnTileKeyDown"
              PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseLeftButtonUp="OnTileMouseUp" MouseMove="OnTileMouseMove"
              MouseLeave="OnTileMouseLeave" DragOver="OnTileDragOver" DragLeave="OnTileDragLeave" Drop="OnTileDrop">
        <StackPanel>
          <Grid Width="128" Height="181">
            <Border x:Name="Ring" Background="{StaticResource Neutral100Brush}" BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1"
                    CornerRadius="2" Effect="{StaticResource ShadowMd}">
              <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
            <Rectangle x:Name="Dashes" Visibility="Collapsed" RadiusX="2" RadiusY="2" Stroke="{StaticResource Neutral700Brush}" StrokeThickness="1"
                       StrokeDashArray="4 3" />
            <TextBlock x:Name="BlankText" Visibility="Collapsed" Text="{Binding BlankTileText}" FontSize="11" Foreground="{StaticResource Neutral600Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource WarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="6" Visibility="{Binding ShowsWarnBadge, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource PhFill}" FontSize="13" Text="{StaticResource IconWarning}" Foreground="{StaticResource BgBrush}"
                         HorizontalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource RemoveButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Remove from the book"
                    Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=views:CheckStepView}}"
                    CommandParameter="{Binding Source}" AutomationProperties.Name="{Binding Label, StringFormat=Remove {0} from the book}"
                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Height="16">
            <TextBlock Style="{StaticResource PhFill}" FontSize="11" Text="{StaticResource IconPushPin}" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="12" Foreground="{StaticResource Neutral500Brush}"
                       Margin="0,0,5,0" ToolTip="Stays at the end" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Ph}" FontSize="12" Text="{StaticResource IconTextAa}" Foreground="{StaticResource Neutral300Brush}" Margin="0,0,5,0"
                       Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Neutral300Brush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="110" />
          </StackPanel>
          <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Neutral500Brush}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowsWarnBadge}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Ring" Property="Effect" Value="{x:Null}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Note" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="Transparent" />
          <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="Ring" Property="Effect" Value="{x:Null}" />
          <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
          <Setter TargetName="BlankText" Property="Visibility" Value="Visible" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Neutral500Brush}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsBlank}" Value="True" />
            <Condition Binding="{Binding IsWarned}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="BlankText" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Note" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Ring" Property="Effect" Value="{StaticResource DropGlow}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent200Brush}" />
        </DataTrigger>
        <Trigger SourceName="DragSurface" Property="views:Ui.IsDragSource" Value="True">
          <Setter TargetName="DragSurface" Property="Opacity" Value="0.35" />
        </Trigger>
        <Trigger SourceName="DragSurface" Property="views:Ui.IsDropTarget" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Ring" Property="Effect" Value="{StaticResource DropGlow}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A page on a printed face (As printed view). -->
    <DataTemplate x:Key="SheetTile" DataType="{x:Type vm:PageViewModel}">
      <StackPanel x:Name="SheetSurface" Width="84" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AutomationName}" Background="Transparent"
                  MouseLeftButtonUp="OnSheetTileClick">
        <Grid Width="84" Height="119">
          <Border x:Name="Ring" Background="{StaticResource Neutral100Brush}" BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1">
            <Image Source="{Binding Image}" Stretch="Uniform" />
          </Border>
          <Rectangle x:Name="Dashes" Visibility="Collapsed" Stroke="{StaticResource Neutral700Brush}" StrokeThickness="1" StrokeDashArray="4 3" />
          <TextBlock x:Name="BlankText" Visibility="Collapsed" Text="{Binding BlankTileText}" FontSize="10" Foreground="{StaticResource Neutral600Brush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource WarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="4" Visibility="{Binding ShowsWarnBadge, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource PhFill}" FontSize="11" Text="{StaticResource IconWarning}" Foreground="{StaticResource BgBrush}"
                       HorizontalAlignment="Center" />
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,0" CornerRadius="3" Background="{StaticResource Neutral900Brush}"
                  ToolTip="Printed page number">
            <Border.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                <Binding Path="HasPrintedNumber" />
                <Binding Path="DataContext.ShowsPageNumbers" RelativeSource="{RelativeSource AncestorType=views:CheckStepView}" />
              </MultiBinding>
            </Border.Visibility>
            <TextBlock Text="{Binding PrintedNumber}" FontSize="10" Foreground="{StaticResource Neutral200Brush}" />
          </Border>
        </Grid>
        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Neutral300Brush}" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ShowsWarnBadge}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent200Brush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelectable}" Value="True">
          <Setter TargetName="SheetSurface" Property="Cursor" Value="Hand" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="Transparent" />
          <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
          <Setter TargetName="BlankText" Property="Visibility" Value="Visible" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Neutral500Brush}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsBlank}" Value="True" />
            <Condition Binding="{Binding IsWarned}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="BlankText" Property="Foreground" Value="{StaticResource WarningBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FaceTemplate" DataType="{x:Type vm:FaceViewModel}">
      <StackPanel Orientation="Horizontal">
        <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource SheetTile}" Margin="0,0,1,0" />
        <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource SheetTile}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
  <StackPanel>
    <!-- Warning chips -->
    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,-4,0,18" Visibility="{Binding HasChips, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource WarningTintBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8" AutomationProperties.Name="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource PhFill}" FontSize="12" Text="{StaticResource IconWarning}" Foreground="{StaticResource WarningBrush}" />
              <TextBlock Text="{Binding}" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Reading order: spreads -->
    <ItemsControl ItemsSource="{Binding Spreads}" Visibility="{Binding IsReadingView, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:SpreadViewModel}">
          <StackPanel Margin="0,0,30,28">
            <StackPanel Orientation="Horizontal">
              <ContentControl Width="128" VerticalAlignment="Top" Margin="0,0,2,0" Content="{Binding Left}" ContentTemplate="{StaticResource BookTile}" Style="{StaticResource SlotStyle}" />
              <ContentControl Width="128" VerticalAlignment="Top" Content="{Binding Right}" ContentTemplate="{StaticResource BookTile}" Style="{StaticResource SlotStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource Neutral600Brush}" Margin="0,8,0,0" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- As printed: sheets -->
    <ItemsControl ItemsSource="{Binding Sheets}" Visibility="{Binding IsSheetsView, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:SheetViewModel}">
          <Border Style="{StaticResource Card}" Padding="16,14,16,16" Margin="0,0,16,16" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                <Border Style="{StaticResource TagAccent}" Margin="8,0,0,0" Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock FontSize="11" Text="test sheet + covers" Foreground="{StaticResource Accent100Brush}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="FRONT" FontSize="10" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,0,6" />
                  <ContentControl Content="{Binding Front}" ContentTemplate="{StaticResource FaceTemplate}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="BACK" FontSize="10" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,0,6" />
                  <ContentControl Content="{Binding Back}" ContentTemplate="{StaticResource FaceTemplate}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>

  <!-- The story text editor: follows the page while the spreads scroll (see CheckStepView.xaml.cs). -->
  <Border x:Name="EditorPanel" Grid.Column="1" Width="316" Margin="24,2,0,24" Padding="16" VerticalAlignment="Top" CornerRadius="{StaticResource RadiusLg}"
          Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Neutral800Brush}" BorderThickness="1" RenderTransformOrigin="0,0"
          AutomationProperties.Name="Story text">
    <Border.RenderTransform>
      <TranslateTransform x:Name="EditorShift" />
    </Border.RenderTransform>
    <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <StackPanel Margin="8,28" Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Ph}" FontSize="32" Text="{StaticResource IconTextAa}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="Click a page to give it words" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Style="{StaticResource EditorNote}" Margin="0,8,0,0" Text="The text sits on the picture, or on a page of its own facing it." />
        </StackPanel>

        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding SelectedTitle}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SelectedFile}" FontSize="11" Foreground="{StaticResource Neutral500Brush}" FontFamily="{StaticResource MonoFont}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" Command="{Binding SelectPreviousCommand}"
                    IsEnabled="{Binding AtFirstPage, Converter={StaticResource InverseBool}}" ToolTip="Previous page" AutomationProperties.Name="Previous page"
                    views:Ui.Icon="{StaticResource IconCaretLeft}" />
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" Command="{Binding SelectNextCommand}"
                    IsEnabled="{Binding AtLastPage, Converter={StaticResource InverseBool}}" ToolTip="Next page" AutomationProperties.Name="Next page"
                    views:Ui.Icon="{StaticResource IconCaretRight2}" Margin="2,0,0,0" />
          </Grid>

          <Border Margin="0,16,0,0" Padding="0,14" CornerRadius="8" Background="{StaticResource Bg70Brush}">
            <ItemsControl ItemsSource="{Binding PreviewTiles}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                  <Border Width="{Binding DataContext.PreviewTileWidth, RelativeSource={RelativeSource AncestorType=views:CheckStepView}}"
                          Height="{Binding DataContext.PreviewTileHeight, RelativeSource={RelativeSource AncestorType=views:CheckStepView}}" Margin="1,0"
                          Background="{StaticResource Neutral100Brush}" CornerRadius="2" Effect="{StaticResource ShadowMd}"
                          AutomationProperties.Name="{Binding Label, StringFormat=Preview of {0}}">
                    <Image Source="{Binding Image}" Stretch="Uniform" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Style="{StaticResource EditorLabel}" Text="Story text" Margin="0,16,0,5" />
          <TextBox x:Name="StoryBox" Text="{Binding StoryInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource AndikaFont}" FontSize="15" Padding="10,8"
                   AutomationProperties.Name="Story text" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasFitNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock x:Name="FitIcon" FontSize="14" VerticalAlignment="Top" Margin="0,1,6,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Ph}">
                  <Setter Property="Text" Value="{StaticResource IconCheckSmall}" />
                  <Setter Property="Foreground" Value="{StaticResource Neutral400Brush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FitTone}" Value="Shrunk">
                      <Setter Property="Text" Value="{StaticResource IconArrowsIn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FitTone}" Value="TooLong">
                      <Setter Property="FontFamily" Value="{StaticResource PhosphorFillFont}" />
                      <Setter Property="Text" Value="{StaticResource IconWarning}" />
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="FitText" Text="{Binding FitNote}" MaxWidth="260">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EditorNote}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FitTone}" Value="TooLong">
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Visibility="{Binding HasStoryText, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource EditorLabel}" Text="Where the words go" Margin="0,16,0,5" />
            <Border Style="{StaticResource SegBorder}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegOption}" Content="On the picture" views:Ui.Icon="{StaticResource IconImageSquare}" GroupName="Placement"
                             AutomationProperties.Name="Words on the picture"
                             IsChecked="{Binding SelectedPlacement, Converter={StaticResource EnumBool}, ConverterParameter={x:Static text:TextPlacement.OnPicture}}" />
                <Rectangle Style="{StaticResource SegDivider}" />
                <RadioButton Style="{StaticResource SegOption}" Content="Own page" views:Ui.Icon="{StaticResource IconBookOpenTextPlacement}" GroupName="Placement"
                             AutomationProperties.Name="Words on a page of their own" IsEnabled="{Binding CanChooseOwnPage}"
                             IsChecked="{Binding SelectedPlacement, Converter={StaticResource EnumBool}, ConverterParameter={x:Static text:TextPlacement.OwnPage}}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Style="{StaticResource Ph}" FontSize="14" Text="{StaticResource IconInfo}" Foreground="{StaticResource Accent300Brush}" VerticalAlignment="Top" Margin="0,1,6,0" />
              <TextBlock Style="{StaticResource EditorNote}" Text="{Binding PlacementNote}" MaxWidth="260" />
            </StackPanel>
          </StackPanel>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Spinner}" FontSize="12" Text="{StaticResource IconCircleNotch}" Foreground="{StaticResource Neutral500Brush}" Margin="0,0,6,0"
                         Visibility="{Binding IsSavingText, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding SaveText}" FontSize="11" Foreground="{StaticResource Neutral500Brush}" TextWrapping="Wrap" MaxWidth="150" AutomationProperties.Name="Save status" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Remove text" views:Ui.Icon="{StaticResource IconEraser}" Command="{Binding RemoveStoryTextCommand}"
                    Visibility="{Binding HasStoryText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Remove text" />
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Border>
  </Grid>
</UserControl>
