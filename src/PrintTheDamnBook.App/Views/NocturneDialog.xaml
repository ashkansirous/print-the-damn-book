<Window x:Class="PrintTheDamnBook.App.Views.NocturneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PrintTheDamnBook.App.Views"
        Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
  <!-- The Nocturne dialog over a backdrop that covers the whole owner window. -->
  <Grid Background="{StaticResource BackdropBrush}">
    <Border x:Name="Card" MaxWidth="440" Margin="24" Padding="11.2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource Neutral500Brush}" BorderThickness="1" CornerRadius="14" Effect="{StaticResource ShadowLg}">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Medium" TextWrapping="Wrap" />
        <ScrollViewer x:Name="BodyScroller" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,8.4,0,0">
          <TextBlock x:Name="BodyText" FontSize="14" Opacity="0.85" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" Margin="0,0,5.6,0" Click="OnSecondaryClick" />
          <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnPrimaryClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
