<Window x:Class="PrintTheDamnBook.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrintTheDamnBook.App.ViewModels"
        xmlns:views="clr-namespace:PrintTheDamnBook.App.Views"
        Title="Print the damn book" Width="1100" Height="800" MinWidth="700" MinHeight="500">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- One printed face: two pages side by side. -->
    <DataTemplate x:Key="FaceTemplate" DataType="{x:Type vm:FaceViewModel}">
      <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
        <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource PageTemplate}" />
        <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource PageTemplate}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Left" Content="Open folder..." Padding="14,6" Command="{Binding OpenFolderCommand}" />
      <TextBlock Text="{Binding FolderPath}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" DataContext="{Binding Print}">
      <TextBlock Text="Printer:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox Width="260" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name" />
      <TextBlock Text="Paper:" VerticalAlignment="Center" Margin="12,0,6,0" />
      <ComboBox Width="80" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}" />
      <TextBlock Text="Two-sided:" VerticalAlignment="Center" Margin="12,0,6,0" />
      <ComboBox Width="220" IsEnabled="{Binding IsIdle}" ItemsSource="{Binding DuplexChoices}" SelectedItem="{Binding SelectedDuplex}" DisplayMemberPath="Label" />
      <CheckBox Content="Reverse order of backs" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="{Binding ReverseBacks}" IsEnabled="{Binding IsIdle}"
                Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
      <CheckBox Content="Rotate backs 180°" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="{Binding RotateBacks}" IsEnabled="{Binding IsIdle}"
                Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
      <CheckBox Content="Print cover sheet as a separate job" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="{Binding SeparateCoverJob}" IsEnabled="{Binding IsIdle}" />
      <Button Content="Print test sheet" Padding="14,6" Margin="12,0,0,0" Command="{Binding PrintTestSheetCommand}" />
      <Button Content="Print booklet" Padding="14,6" Margin="8,0,0,0" Command="{Binding PrintCommand}" />
      <Button Content="Print backs again" Padding="14,6" Margin="8,0,0,0" Command="{Binding PrintBacksAgainCommand}"
              Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding PrintStatus}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </WrapPanel>

    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" DataContext="{Binding Print}" Text="{Binding DuplexNote}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DuplexNote}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0B000" BorderThickness="1" Padding="8" Margin="0,0,0,8">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Warning}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" />

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <views:PageStrip Grid.Row="0" />

      <GroupBox Grid.Row="1" Header="Sheets as they will print" Margin="0,8,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Sheets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SheetViewModel}">
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                      <StackPanel>
                        <TextBlock Text="Front" Foreground="Gray" />
                        <ContentControl Content="{Binding Front}" ContentTemplate="{StaticResource FaceTemplate}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Back" Foreground="Gray" />
                        <ContentControl Content="{Binding Back}" ContentTemplate="{StaticResource FaceTemplate}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
