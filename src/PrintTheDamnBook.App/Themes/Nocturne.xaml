<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Nocturne tokens from docs/design/nocturne/styles.css, dark theme only. -->

  <Color x:Key="BgColor">#161826</Color>
  <Color x:Key="SurfaceColor">#232532</Color>
  <Color x:Key="TextColor">#E9E9ED</Color>
  <Color x:Key="AccentColor">#9184D9</Color>
  <!-- oklch(0.82 0.12 78), converted once to sRGB. The mock's warning colour, not a Nocturne token. -->
  <Color x:Key="WarningColor">#EFBA64</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

  <!-- color-mix(in srgb, X n%, transparent) as plain alpha colours. -->
  <SolidColorBrush x:Key="DividerBrush" Color="#29E9E9ED" />                 <!-- text 16% -->
  <SolidColorBrush x:Key="Text6Brush" Color="#0FE9E9ED" />
  <SolidColorBrush x:Key="Text7Brush" Color="#12E9E9ED" />
  <SolidColorBrush x:Key="Text8Brush" Color="#14E9E9ED" />
  <SolidColorBrush x:Key="Text14Brush" Color="#24E9E9ED" />
  <SolidColorBrush x:Key="Text45Brush" Color="#73E9E9ED" />
  <SolidColorBrush x:Key="Text70Brush" Color="#B3E9E9ED" />
  <SolidColorBrush x:Key="Accent10Brush" Color="#1A9184D9" />
  <SolidColorBrush x:Key="Accent12Brush" Color="#1F9184D9" />
  <SolidColorBrush x:Key="Accent18Brush" Color="#2E9184D9" />
  <SolidColorBrush x:Key="Accent22Brush" Color="#389184D9" />
  <SolidColorBrush x:Key="WarningTintBrush" Color="#24EFBA64" />            <!-- warning 14% -->
  <SolidColorBrush x:Key="Bg70Brush" Color="#B3161826" />
  <SolidColorBrush x:Key="BackdropBrush" Color="#80292B31" />                <!-- neutral-900 50% -->

  <SolidColorBrush x:Key="Neutral100Brush" Color="#F3F5FE" />
  <SolidColorBrush x:Key="Neutral200Brush" Color="#E4E7F5" />
  <SolidColorBrush x:Key="Neutral300Brush" Color="#CFD3E5" />
  <SolidColorBrush x:Key="Neutral400Brush" Color="#B2B6CA" />
  <SolidColorBrush x:Key="Neutral500Brush" Color="#9397AB" />
  <SolidColorBrush x:Key="Neutral600Brush" Color="#75798C" />
  <SolidColorBrush x:Key="Neutral700Brush" Color="#595D6C" />
  <SolidColorBrush x:Key="Neutral800Brush" Color="#3F424D" />
  <SolidColorBrush x:Key="Neutral900Brush" Color="#292B31" />

  <SolidColorBrush x:Key="Accent200Brush" Color="#E7E5FE" />
  <SolidColorBrush x:Key="Accent300Brush" Color="#D2CEFD" />
  <SolidColorBrush x:Key="Accent700Brush" Color="#5D5294" />
  <SolidColorBrush x:Key="Accent800Brush" Color="#423A6A" />
  <SolidColorBrush x:Key="Accent900Brush" Color="#2B2741" />
  <SolidColorBrush x:Key="Accent100Brush" Color="#F5F4FF" />

  <!-- Window close hover, from the mock. -->
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>

  <!-- Shadows: shadow-sm is the 1 px ring (use Neutral800Brush as a 1 px border); md and lg add blur. -->
  <DropShadowEffect x:Key="ShadowMd" Color="Black" Opacity="0.55" BlurRadius="18" ShadowDepth="6" Direction="270" />
  <DropShadowEffect x:Key="ShadowLg" Color="Black" Opacity="0.65" BlurRadius="40" ShadowDepth="16" Direction="270" />
  <DropShadowEffect x:Key="DropGlow" Color="#9184D9" Opacity="0.55" BlurRadius="22" ShadowDepth="0" />
  <DropShadowEffect x:Key="NextGlow" Color="#9184D9" Opacity="0.35" BlurRadius="18" ShadowDepth="0" />
  <DropShadowEffect x:Key="StepGlow" Color="#9184D9" Opacity="0.45" BlurRadius="14" ShadowDepth="0" />

  <FontFamily x:Key="InterFont">pack://application:,,,/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="PhosphorFont">pack://application:,,,/Fonts/#Phosphor</FontFamily>
  <FontFamily x:Key="PhosphorFillFont">pack://application:,,,/Fonts/#Phosphor-Fill</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
</ResourceDictionary>
