<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:PrintTheDamnBook.App.Views">
  <!-- Nocturne component styles: buttons, segmented control, switch, input, select, scrollbar, tooltip, card, tag. -->

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <views:InverseBoolVisibilityConverter x:Key="InverseBoolToVisibility" />
  <views:PresentVisibilityConverter x:Key="PresentToVisibility" />
  <views:EnumBoolConverter x:Key="EnumBool" />
  <views:InverseBoolConverter x:Key="InverseBool" />

  <!-- Keyboard focus (Nocturne :focus-visible): a 2 px accent ring, 2 px outside the control; the inset one sits inside for tight controls. WPF shows it for keyboard focus only. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusRingInset">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Phosphor glyph: put a code point from Icons.xaml in Text. -->
  <Style x:Key="Ph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PhosphorFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PhFill" TargetType="TextBlock" BasedOn="{StaticResource Ph}">
    <Setter Property="FontFamily" Value="{StaticResource PhosphorFillFont}" />
  </Style>
  <Style x:Key="Spinner" TargetType="TextBlock" BasedOn="{StaticResource Ph}">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard x:Name="Spin">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360"
                               Duration="0:0:0.9" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Spin" />
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Neutral400Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}" />
  </Style>

  <!-- Buttons. Ui.Icon and Ui.TrailingIcon add Phosphor glyphs; Ui.HoverBrush and Ui.PressedBrush tint the face. -->
  <Style x:Key="NocturneButton" TargetType="Button">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="views:Ui.HoverBrush" Value="{StaticResource Text7Brush}" />
    <Setter Property="views:Ui.PressedBrush" Value="{StaticResource Text14Brush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" />
            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusMd}" Background="{Binding (views:Ui.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusMd}" Background="{Binding (views:Ui.PressedBrush), RelativeSource={RelativeSource TemplatedParent}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
              <TextBlock Style="{StaticResource Ph}" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}"
                         Text="{Binding (views:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource PresentToVisibility}}" />
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
              <TextBlock Style="{StaticResource Ph}" Margin="6,0,0,0" Foreground="{TemplateBinding Foreground}"
                         Text="{Binding (views:Ui.TrailingIcon), RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource PresentToVisibility}}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Press" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource NocturneButton}" />

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NocturneButton}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="views:Ui.HoverBrush" Value="{StaticResource Accent12Brush}" />
    <Setter Property="views:Ui.PressedBrush" Value="{StaticResource Accent22Brush}" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NocturneButton}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="views:Ui.HoverBrush" Value="{StaticResource Accent10Brush}" />
    <Setter Property="views:Ui.PressedBrush" Value="{StaticResource Accent18Brush}" />
  </Style>

  <!-- Title bar caption buttons: 46 px wide. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Foreground" Value="{StaticResource Neutral300Brush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent">
            <TextBlock x:Name="Glyph" Style="{StaticResource Ph}" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}" Text="{Binding (views:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Text8Brush}" />
            </Trigger>
            <Trigger Property="views:Ui.IsPointerOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Text8Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent">
            <TextBlock x:Name="Glyph" Style="{StaticResource Ph}" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}" Text="{Binding (views:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CloseHoverBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Neutral100Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: RadioButtons in a SegBorder, divided by SegDivider rectangles. -->
  <Style x:Key="SegOption" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="11,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ph}" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}"
                         Text="{Binding (views:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource PresentToVisibility}}" />
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Text7Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegBorder" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="SegDivider" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Fill" Value="{StaticResource DividerBrush}" />
  </Style>

  <!-- Switch row: 36x20 track, 12 px knob, content to its right. -->
  <Style x:Key="SwitchRow" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Track" Width="36" Height="20" Margin="0,1,12,0" VerticalAlignment="Top" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{StaticResource Neutral600Brush}" Background="Transparent">
              <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="{StaticResource Neutral400Brush}" />
            </Border>
            <ContentPresenter VerticalAlignment="Top" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent22Brush}" />
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Knob" Property="Margin" Value="18,0,0,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Input -->
  <Style TargetType="TextBox">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusMd}">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Text45Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Select -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Text8Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <TextBlock Style="{StaticResource Ph}" FontSize="14" Text="{StaticResource IconCaretDown}" HorizontalAlignment="Right"
                               Margin="0,0,10,0" Foreground="{StaticResource Neutral400Brush}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Text45Brush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="10,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,14,16"
                      Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Neutral700Brush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusMd}" Effect="{StaticResource ShadowMd}" Padding="0,4">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin dark scrollbars -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="4" Background="{StaticResource Neutral800Brush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Neutral700Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Root" Background="Transparent" Width="12">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" Margin="2" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="Root" Property="Width" Value="Auto" />
              <Setter TargetName="Root" Property="Height" Value="12" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
              <Setter TargetName="PART_Track" Property="Thumb.Margin" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Neutral700Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Card: surface colour with the 1 px shadow-sm ring. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Neutral800Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="TagAccent" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Accent800Brush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TagNeutral" TargetType="Border" BasedOn="{StaticResource TagAccent}">
    <Setter Property="Background" Value="{StaticResource Neutral800Brush}" />
  </Style>
</ResourceDictionary>
