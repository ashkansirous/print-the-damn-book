<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PrintTheDamnBook</AssemblyName>
    <!-- Publish: self-contained single exe, compressed (about 65 MB instead of 140 MB), no ReadyToRun. RuntimeIdentifier and SelfContained come from the
         release workflow's command line so plain build/test stay framework-dependent. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The font licence texts are embedded too: the release is a single exe, and the Licences dialog shows them. -->
    <Resource Include="Fonts\*.ttf;Fonts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintTheDamnBook.Core\PrintTheDamnBook.Core.csproj" />
  </ItemGroup>

</Project>
